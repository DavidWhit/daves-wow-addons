# BigWigsMods/packager config (https://github.com/BigWigsMods/packager)
# Builds the release zip; run locally with release.sh or in GitHub Actions
# via BigWigsMods/packager@v2.
package-as: HelloForever

ignore:
  - README.md
  - NOTES.md
  - .luacheckrc
  - .vscode
  - tests
  - tools
  - __pycache__
